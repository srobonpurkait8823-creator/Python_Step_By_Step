#String
str1="Hello"
str2='World'
str3='''This is a multi-line
string in Python.'''
str4="""Python programming is fun with Apna College's PYTHON course!"""
print(str1)
print(str2)     
print(str3)
print(str4)
#End


#Type of string variables
print("Type of str1:", type(str1))
print("Type of str2:", type(str2))
print("Type of str3:", type(str3))
print("Type of str4:", type(str4))
str5="Hey there! \n Learn Python with me." # \n is a escape sequence for new line
print(str5)
#End


#String Operations
print("Concatenation of str1 and str2:", str1 + " " + str2)
print("Repetition of str1 three times:", str1 * 3)
print("Repetition of str2 seven times:", str2 * 7)
print("Length of str4:", len(str4))
print("Length of string1:", len(str1))
#End


#Indexing and Slicing
print("Accessing first character of str1:", str1[0]) #Starting index is included, Ending index is excluded
print("Accessing last character of str2:", str2[-1]) #Negative indexing
print("Accessing third character from str5:", str5[2])
print("Accessing fifth character from str5:", str5[4])
# Slicing || ACCESSING PARTS OF STRING
print("Slicing str4 from index 0 to 10:", str4[0:10]) #Ending index is excluded
print("Slicing str4 from index 11 to end:", str4[11:]) #If no end index is provided, it goes to the end of the string
print("Slicing str5 from index 0 to 3:" , str5[1:3])
print("Slicing str5 from index 0 to 4:" , str5[:4]) #If no starting index is provided, it starts from the beginning of the string
print("Slicing str1 from index 0 to 4:" , str1[-5:-1]) #In case of negative indexing, it starts from the end of the string and goes backwards. Starting index is excluded (-1), Ending index is included(-5)
#End


#String Functions
sample_str="Apna College Python Course"
print(sample_str.endswith("Course"))
print(sample_str.startswith("Apna"))
print(sample_str.endswith("Python"))
print(sample_str.startswith("College"))

print("Original String:", sample_str)
print("After strip():", sample_str.strip())
print("After lower():", sample_str.lower())
print("After upper():", sample_str.upper())
print("After replace 'Python' with 'Java':", sample_str.replace("Python", "Java")) #Replaces all occurrences of 'Python' with 'Java'
print("After replace 'Apna' with 'My':", sample_str.replace("Apna", "My"))
print("After replace 'College' with 'Institute':", sample_str.replace("College", "Institute"))
print("After replace 'Course' with 'Tutorial':", sample_str.replace("Course", "Tutorial"))
print("Find 'College' in sample_str:", sample_str.find("College")) #Returns the starting index of the first occurrence of 'College'
#End
